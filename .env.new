# Production Keys (when ready to go live)
# STRIPE_SECRET_KEY="sk_live_YOUR_KEY_HERE"
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_YOUR_KEY_HERE"
# STRIPE_WEBHOOK_SECRET="whsec_YOUR_WEBHOOK_SECRET_HERE"

# -----------------------------------------------------------------------------
# EMAIL - Resend
# -----------------------------------------------------------------------------
# ⚠️ REQUIRED - Sign up at: https://resend.com
# Free tier: 3,000 emails/month, 100 emails/day
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY="re_YOUR_API_KEY_HERE"

# Email sender address (must be verified domain in production)
# Development: Use any email
# Production: Must use your verified domain (e.g., noreply@yourdomain.com)
EMAIL_FROM="noreply@yourdomain.com"

# -----------------------------------------------------------------------------
# SMS - Twilio
# -----------------------------------------------------------------------------
# ⚠️ CHANGE THESE - Create new Twilio account or rotate credentials
# Get your credentials from: https://console.twilio.com
# Current account: Unknown Twilio account
TWILIO_ACCOUNT_SID="ACc09bca3267fed3a1be5be0eec5ff87f5"
TWILIO_AUTH_TOKEN="078f7b4ecbbf25f413f1333ad5c1c612"
TWILIO_PHONE_NUMBER="+18668905584"

# -----------------------------------------------------------------------------
# OPTIONAL - AI Features (OpenAI)
# -----------------------------------------------------------------------------
# Only needed if you want AI-powered message generation
# Get your API key from: https://platform.openai.com/api-keys
# Cost: Pay-as-you-go (approximately $0.002 per message generation)
# OPENAI_API_KEY="sk-YOUR_OPENAI_KEY_HERE"

# -----------------------------------------------------------------------------
# OPTIONAL - Caching (Upstash Redis)
# -----------------------------------------------------------------------------
# Improves performance for dashboard queries
# Sign up at: https://upstash.com (free tier available)
# UPSTASH_REDIS_REST_URL="https://your-redis-instance.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="YOUR_TOKEN_HERE"

# -----------------------------------------------------------------------------
# PRODUCTION ONLY - Monitoring & Error Tracking
# -----------------------------------------------------------------------------
# Sentry - Error tracking and monitoring
# Sign up at: https://sentry.io
# Free tier: 5,000 events/month
# SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"
# NEXT_PUBLIC_SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"

# -----------------------------------------------------------------------------
# PRODUCTION ONLY - Analytics
# -----------------------------------------------------------------------------
# Google Analytics
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
# Enable/disable features
ENABLE_SMS_NOTIFICATIONS="true"
ENABLE_EMAIL_NOTIFICATIONS="true"
ENABLE_AI_FEATURES="false"
ENABLE_RECURRING_DONATIONS="false"

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
# API rate limits (requests per window)
RATE_LIMIT_GLOBAL="300"          # requests per 15 min
RATE_LIMIT_AUTH="5"              # login attempts per 15 min
RATE_LIMIT_DONATIONS="20"        # donations per hour
RATE_LIMIT_UPLOADS="10"          # file uploads per hour

# -----------------------------------------------------------------------------
# FILE UPLOADS
# -----------------------------------------------------------------------------
# Maximum file size in bytes (10MB default)
MAX_FILE_SIZE="10485760"

# Allowed file types for uploads
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/gif,image/webp,text/csv"

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
# Cookie settings
COOKIE_SECURE="false"            # Set to "true" in production (HTTPS only)
COOKIE_SAME_SITE="lax"           # Options: strict, lax, none

# CORS settings
ALLOWED_ORIGINS="http://localhost:3000"  # Comma-separated list

# -----------------------------------------------------------------------------
# DEVELOPMENT ONLY
# -----------------------------------------------------------------------------
# Debugging
NODE_ENV="development"           # Change to "production" when deploying
DEBUG="false"

# Seed data (only in development)
# SEED_DATABASE="false"

# =============================================================================
# END OF CONFIGURATION
# =============================================================================
