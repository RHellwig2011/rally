# =============================================================================
# Rally Fundraising Platform - Environment Configuration
# =============================================================================
# Copy this to .env and update ALL values marked with ⚠️
# Created: December 1, 2025
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE - PostgreSQL (Supabase)
# -----------------------------------------------------------------------------
# ⚠️ CHANGE THIS - Current credentials exposed
# Get new credentials from: https://supabase.com
# 1. Create new project
# 2. Go to Project Settings > Database
# 3. Copy "Connection string" (use Pooler mode for better performance)
DATABASE_URL="postgresql://postgres.nsluczmibjdsywwheden:Trump2025@aws-0-us-west-2.pooler.supabase.com:5432/postgres"

# -----------------------------------------------------------------------------
# APP CONFIGURATION
# -----------------------------------------------------------------------------
# Platform fee percentage (default: 10%)
PLATFORM_FEE_PERCENT="10"

# App URL (change in production)
# Development: http://localhost:3000
# Production: https://yourdomain.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# AUTHENTICATION
# -----------------------------------------------------------------------------
# ⚠️ GENERATE NEW SECRET - Current one is insecure
# Generate with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="dev-secret-key-change-in-production"

# JWT Secret (generate separately from NEXTAUTH_SECRET)
# Generate with: openssl rand -base64 32
JWT_SECRET="generate-a-new-secret-here"

# -----------------------------------------------------------------------------
# STRIPE - Payment Processing
# -----------------------------------------------------------------------------
# ⚠️ CHANGE THESE - Create new Stripe account or rotate keys
# Get your keys from: https://dashboard.stripe.com/test/apikeys
# Current account: Test mode keys (unknown account)

# Test Keys (for development)
STRIPE_SECRET_KEY="sk_test_51SXrMrQeHzG5tp9GBCYUPVnC8ecleW12pp0Y9AxRXFTrUnWkt0oDZDldXQoxkhi2U1qH0WXAKQ2vLNp0asA0C36J00HqBbNseO"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_51SXrMrQeHzG5tp9GZrQ48GQp0VdTPdn8jq4yyHRhf9yJPgR06MzujQ7HlWNmtyTN8mgAUBmDUjJ3TMmixiDj8rP2002OONJuPJ"

# Stripe Webhook Secret
# ⚠️ CHANGE THIS - Get from: https://dashboard.stripe.com/test/webhooks
# After deploying, create webhook endpoint pointing to: https://yourdomain.com/api/webhooks/stripe
