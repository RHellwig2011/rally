# --- Schoology ---
# Get these at https://app.schoology.com/api (account settings -> API)
SCHOOLOGY_CONSUMER_KEY=
SCHOOLOGY_CONSUMER_SECRET=
SCHOOLOGY_DOMAIN=https://app.schoology.com
SCHOOLOGY_USER_ID=me

# --- PowerSchool ---
# Most districts: https://ps.<district>.org/public/
POWERSCHOOL_URL=
POWERSCHOOL_USERNAME=
POWERSCHOOL_PASSWORD=
# One of: form, sso_google
POWERSCHOOL_LOGIN_MODE=form

# --- Study helper (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Local ---
SCHOOLSCRAPER_CACHE_PATH=.schoolscraper.db
