# --- Master key (required for multi-user mode) ---
# Encrypts per-user credentials at rest. Generate once and never change:
# python -c 'import secrets; print(secrets.token_urlsafe(32))'
SCHOOLSCRAPER_MASTER_KEY=

# --- Single-user fallback (used by `sync` if no users are configured) ---
# Schoology: https://app.schoology.com/api  (account settings -> API)
SCHOOLOGY_CONSUMER_KEY=
SCHOOLOGY_CONSUMER_SECRET=
SCHOOLOGY_DOMAIN=https://app.schoology.com
SCHOOLOGY_USER_ID=me

POWERSCHOOL_URL=
POWERSCHOOL_USERNAME=
POWERSCHOOL_PASSWORD=
# One of: form, sso_google
POWERSCHOOL_LOGIN_MODE=form

# --- Study helper (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Server (Pi service) ---
SCHOOLSCRAPER_HOST=0.0.0.0
SCHOOLSCRAPER_PORT=8765
SCHOOLSCRAPER_SYNC_MINUTES=60
# Shared secret for /api/* calls. Not required for /alexa.
SCHOOLSCRAPER_API_TOKEN=

# --- Alexa Skill ---
# From the Alexa Developer Console after creating your skill.
# Used to verify incoming requests come from your skill.
ALEXA_SKILL_ID=

# --- Local ---
SCHOOLSCRAPER_CACHE_PATH=/var/lib/schoolscraper/schoolscraper.db
