# =============================================================================
# Rally / Bleacher Backers — environment configuration
#
# Copy to .env and fill in. Never commit the resulting .env.
# Vars are grouped: required first, then per-integration, then optional.
# =============================================================================

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------

# Signs session cookies and refresh tokens (lib/jwt-secret.ts).
# The app REFUSES TO START in production when this is unset or still the
# development fallback — tokens would otherwise be forgeable by anyone.
# Generate with: openssl rand -hex 32
JWT_SECRET=""

# Postgres connection string. Prisma has no @map, so columns are camelCase.
DATABASE_URL="postgresql://user:password@localhost:5432/rally?schema=public"

# Public origin of the app. Used to build links in emails/SMS and redirects.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Cron
# -----------------------------------------------------------------------------

# Required. /api/cron/* fails CLOSED (503) when this is unset.
# The scheduler must send: Authorization: Bearer ${CRON_SECRET}
# vercel.json schedules /api/cron/campaign-automation hourly; without this
# value set in the deploy environment the job runs but is rejected, so
# campaigns are never auto-completed at their end date.
# Generate with: openssl rand -hex 24
CRON_SECRET=""

# -----------------------------------------------------------------------------
# Stripe (payments)
# -----------------------------------------------------------------------------

# Get your keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_YOUR_KEY_HERE"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_YOUR_KEY_HERE"
# Get webhook secret from https://dashboard.stripe.com/test/webhooks
# Gates completeDonation — a leaked value allows forged donation completions.
STRIPE_WEBHOOK_SECRET="whsec_YOUR_WEBHOOK_SECRET_HERE"

# DEV ONLY. Set to "true" to skip Stripe webhook signature verification when
# replaying events locally. Ignored (hard-disabled) when NODE_ENV=production.
# Leave unset unless you are actively debugging webhooks.
ALLOW_UNSIGNED_WEBHOOKS=""

# -----------------------------------------------------------------------------
# Email (Resend — https://resend.com)
# -----------------------------------------------------------------------------

# Get your API key from https://resend.com/api-keys
# Free tier: 3,000 emails/month, 100 emails/day
RESEND_API_KEY="re_YOUR_API_KEY_HERE"
EMAIL_FROM="noreply@yourdomain.com"

# CAN-SPAM requires a valid physical postal address in every non-transactional
# email. Falls back to a hardcoded default in lib/suppression.ts if unset —
# set your real address before sending marketing/outreach mail.
MAILING_ADDRESS="Your Org, 123 Example St, City, ST 00000"

# -----------------------------------------------------------------------------
# SMS (Twilio — https://twilio.com)
# -----------------------------------------------------------------------------

# Get your credentials from https://console.twilio.com
# The Account SID (AC…) is always required. There are TWO independent auth
# concerns here, and satisfying one does not satisfy the other:
#
#   OUTBOUND (we call Twilio) — prefer an API Key (Console → Account → API keys
#   & tokens): API Keys are scoped and can be revoked without rotating the
#   account's primary Auth Token. If both an API Key and an Auth Token are set,
#   the API Key wins.
#
#   INBOUND (Twilio calls us) — requires TWILIO_AUTH_TOKEN, always. Twilio signs
#   the X-Twilio-Signature header on inbound webhooks with the account Auth
#   Token; an API Key CANNOT validate that signature. Configuring API Keys alone
#   produces a deployment where sending works while every inbound STOP is
#   refused, so opt-outs are silently never recorded — a TCPA violation.
#   GET /api/health reports sms.inboundWebhook = "unverifiable" in that state.
TWILIO_ACCOUNT_SID="AC_YOUR_ACCOUNT_SID_HERE"
# Preferred for OUTBOUND: API Key auth (SK… + its secret, shown once at creation)
TWILIO_API_KEY_SID="SK_YOUR_API_KEY_SID_HERE"
TWILIO_API_KEY_SECRET="your_api_key_secret_here"
# REQUIRED for INBOUND webhook signature validation, regardless of the API Key
# above. Also serves as the outbound fallback when no API Key is set.
TWILIO_AUTH_TOKEN="your_auth_token_here"
# Must be a number owned by THIS account and SMS-capable
TWILIO_PHONE_NUMBER="+1234567890"

# -----------------------------------------------------------------------------
# OpenAI (AI-generated outreach messages and help chat)
# -----------------------------------------------------------------------------

# Optional. The AI message/poster/help endpoints return a clear error when
# unset; the rest of the app works without it.
OPENAI_API_KEY="sk-YOUR_KEY_HERE"

# ------------------------------------------------------------------------------
# Social sign-in (Google / Apple)
# ------------------------------------------------------------------------------

# Optional. A provider is enabled only when ALL of its vars are set; otherwise
# its button is hidden and its endpoints redirect to /login with an error
# (graceful degradation — nothing else breaks).
#
# GOOGLE — https://console.cloud.google.com/apis/credentials
#   Create an OAuth 2.0 Client ID (Web application). Authorized redirect URI:
#   ${NEXT_PUBLIC_APP_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
#
# APPLE — https://developer.apple.com (Certificates, Identifiers & Profiles)
#   APPLE_CLIENT_ID is the Services ID (e.g. com.example.bleacherbackers.signin),
#   NOT the app bundle id. Configure its return URL as:
#   ${NEXT_PUBLIC_APP_URL}/api/auth/oauth/apple/callback
#   APPLE_PRIVATE_KEY is the full .p8 contents; literal "\n" escapes are OK.
#   Note: Apple's callback is a cross-site POST, which requires SameSite=None;
#   Secure — so Apple sign-in only works over HTTPS (production), not local http.
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# -----------------------------------------------------------------------------
# Optional tuning
# -----------------------------------------------------------------------------

# Refresh-token lifetime in days (lib/auth.ts). Defaults to 30 when unset.
REFRESH_TOKEN_EXPIRES_DAYS="30"

# =============================================================================
# Not currently used
#
# Nothing in the codebase reads the variables below. They are listed only so
# an operator migrating from an older .env knows they can be dropped.
#
#   NEXTAUTH_URL, NEXTAUTH_SECRET
#     next-auth is not a dependency. NEXTAUTH_SECRET is NOT the session
#     secret — that is JWT_SECRET above.
#
#   AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION, AWS_S3_BUCKET
#     No AWS SDK and no S3 upload path exists.
#
#   REDIS_URL
#     Rate limiting and sessions are not Redis-backed.
#
#   PLATFORM_FEE_PERCENT
#     The platform fee comes from the PlatformSettings.platformFeePercent
#     database column, not from the environment.
# =============================================================================
