# Database
DATABASE_URL="postgresql://user:password@localhost:5432/boba?schema=public"

# Next Auth / Authentication
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# Stripe (for production payments)
# Get your keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_YOUR_KEY_HERE"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_YOUR_KEY_HERE"
# Get webhook secret from https://dashboard.stripe.com/test/webhooks
STRIPE_WEBHOOK_SECRET="whsec_YOUR_WEBHOOK_SECRET_HERE"

# Email (Resend - https://resend.com)
# Get your API key from https://resend.com/api-keys
# Free tier: 3,000 emails/month, 100 emails/day
RESEND_API_KEY="re_YOUR_API_KEY_HERE"
EMAIL_FROM="noreply@yourdomain.com"

# SMS (Twilio - https://twilio.com)
# Get your credentials from https://console.twilio.com
# Free trial: $15 credit (about 450 SMS messages)
TWILIO_ACCOUNT_SID="AC_YOUR_ACCOUNT_SID_HERE"
TWILIO_AUTH_TOKEN="your_auth_token_here"
TWILIO_PHONE_NUMBER="+1234567890"

# File Upload (AWS S3 or Cloudflare R2)
AWS_ACCESS_KEY_ID="..."
AWS_SECRET_ACCESS_KEY="..."
AWS_REGION="us-east-1"
AWS_S3_BUCKET="boba-uploads"

# Redis (for caching and sessions)
REDIS_URL="redis://localhost:6379"

# App Config
PLATFORM_FEE_PERCENT="10"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
