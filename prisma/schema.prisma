// Boba Fundraising Platform - Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// PLATFORM SETTINGS (singleton row, id = "singleton")
// ============================================================================

model PlatformSettings {
  id                       String   @id @default("singleton")

  // Financial (money stored in cents)
  platformFeePercent       Float    @default(10.0)
  minDonationAmountCents   BigInt   @default(100) // $1
  maxDonationAmountCents   BigInt   @default(1000000) // $10,000
  suggestedAmountsCents    BigInt[] @default([2500, 5000, 10000, 25000])

  // Platform configuration
  maxFileUploadSizeMb      Int      @default(5)
  termsOfServiceUrl        String   @default("")
  privacyPolicyUrl         String   @default("")

  // Communication
  supportEmail             String   @default("support@rallyfundraising.com")
  enableEmailNotifications Boolean  @default(true)
  enableSmsNotifications   Boolean  @default(false)

  // System
  maintenanceMode          Boolean  @default(false)

  updatedAt                DateTime @updatedAt
}

// ============================================================================
// USER MANAGEMENT
// ============================================================================

enum UserRole {
  DONOR
  PLAYER
  TEAM_MEMBER
  CAMPAIGN_LEADER
  GUARDIAN
  ADMIN
  BANK_ADMIN
}

enum KYCStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  phone         String?
  firstName     String
  lastName      String
  role          UserRole  @default(DONOR)

  // Authentication
  passwordHash  String
  // Social sign-in. Nullable + unique: Postgres treats NULLs as distinct, so
  // password-only users are unaffected. A user created via OAuth gets a random
  // unusable passwordHash and can add a real password via the reset flow.
  googleId      String?   @unique
  appleId       String?   @unique
  verificationToken String?
  verificationTokenExpiry DateTime?
  passwordResetToken String?
  passwordResetTokenExpiry DateTime?

  // Verification
  emailVerified Boolean   @default(false)
  phoneVerified Boolean   @default(false)
  kycStatus     KYCStatus?
  termsAcceptedAt DateTime?

  // Metadata
  programsCreated   Program[]      @relation("ProgramCreator")
  rosterImports     RosterImport[] @relation("RosterImporter")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  ledCampaigns              Campaign[]                @relation("CampaignLeader")
  guardedCampaigns          Campaign[]                @relation("Guardians")
  donations                 Donation[]
  campaignUpdates           CampaignUpdate[]
  disbursementRequests      DisbursementRequest[]     @relation("RequestedBy")
  approvedDisbursements     DisbursementRequest[]     @relation("ApprovedBy")
  transactions              Transaction[]
  referrals                 Referral[]
  teamMemberships           TeamMember[]
  refreshTokens             RefreshToken[]
  outreachCampaigns         OutreachCampaign[]
  scheduledStatusChanges    ScheduledStatusChange[]   @relation("ScheduledStatusChangeCreator")
  createdCampaignTemplates  CampaignTemplate[]        @relation("CampaignTemplateCreator")

  @@index([email])
}

// ============================================================================
// REFRESH TOKENS (ROTATING)
// ============================================================================

model RefreshToken {
  id           String   @id @default(cuid())
  tokenHash    String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  revoked      Boolean  @default(false)
  replacedById String?
  replacedBy   RefreshToken? @relation("replacedBy", fields: [replacedById], references: [id])
  replacedByTokens RefreshToken[] @relation("replacedBy")
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  createdByIp  String?
  revokedAt    DateTime?
  revokedByIp  String?
  reason       String?

  @@index([userId])
}

// ============================================================================
// CAMPAIGN MANAGEMENT
// ============================================================================

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum CampaignCategory {
  SPORTS
  ARTS
  EDUCATION
  COMMUNITY
  OTHER
}

model Program {
  id                String     @id @default(cuid())
  organizationName  String
  teamName          String
  sport             String?
  slug              String     @unique

  createdById       String
  createdBy         User       @relation("ProgramCreator", fields: [createdById], references: [id])

  campaigns         Campaign[]
  rosterImports     RosterImport[]
  optOuts           ContactOptOut[]

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@unique([organizationName, teamName])
  @@index([createdById])
}

model Campaign {
  id                String           @id @default(cuid())

  // Program this season belongs to (alumni + year-over-year data hang off Program)
  programId         String?
  program           Program?         @relation(fields: [programId], references: [id])
  seasonYear        Int?

  // Contact collection
  minContactsPerPlayer Int           @default(0)
  rosterImports     RosterImport[]

  // Basic Info
  organizationName  String
  teamName          String
  slug              String           @unique
  description       String           @db.Text
  goalAmount        BigInt           // In cents
  currentAmount     BigInt           @default(0) // In cents
  platformFeePercent Float           @default(10.0)

  // Customization
  logoUrl           String?
  bannerImageUrl    String?
  primaryColor      String           @default("#6366F1")
  secondaryColor    String           @default("#F59E0B")

  // Dates
  startDate         DateTime
  endDate           DateTime?
  completedAt       DateTime?
  archivedAt        DateTime?

  // Status
  status            CampaignStatus   @default(DRAFT)
  category          CampaignCategory @default(OTHER)

  // Staff must verify the named organization before a leader can go live.
  // ADMIN/BANK_ADMIN activation also stamps this.
  organizationVerifiedAt    DateTime?
  organizationVerifiedById  String?

  // Leadership
  primaryLeaderId   String
  primaryLeader     User             @relation("CampaignLeader", fields: [primaryLeaderId], references: [id])
  guardians         User[]           @relation("Guardians")

  // Metadata
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // Relations
  bankingAccount         BankingAccount?
  donations              Donation[]
  updates                CampaignUpdate[]
  cheerMessages          CheerWallMessage[]
  referrals              Referral[]
  teamMembers            TeamMember[]
  outreachCampaigns      OutreachCampaign[]
  scheduledStatusChanges ScheduledStatusChange[]
  clonedFrom             Campaign?           @relation("CampaignClones", fields: [clonedFromId], references: [id])
  clonedFromId           String?
  clones                 Campaign[]          @relation("CampaignClones")

  @@index([slug])
  @@index([status])
  @@index([primaryLeaderId])
  @@index([clonedFromId])
}

// Scheduled status changes for campaigns
model ScheduledStatusChange {
  id              String         @id @default(cuid())
  campaignId      String
  campaign        Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  scheduledStatus CampaignStatus
  scheduledFor    DateTime
  reason          String?

  createdById     String
  createdBy       User           @relation("ScheduledStatusChangeCreator", fields: [createdById], references: [id])

  executed        Boolean        @default(false)
  executedAt      DateTime?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([campaignId])
  @@index([scheduledFor])
  @@index([executed])
}

// Campaign templates for reuse
model CampaignTemplate {
  id                 String           @id @default(cuid())

  // Template Info
  name               String
  description        String?          @db.Text
  category           CampaignCategory @default(OTHER)

  // Template Settings
  goalAmount         BigInt?
  platformFeePercent Float            @default(10.0)
  durationDays       Int?             // Suggested campaign duration

  // Customization
  logoUrl            String?
  bannerImageUrl     String?
  primaryColor       String           @default("#6366F1")
  secondaryColor     String           @default("#F59E0B")

  // Template Description
  descriptionTemplate String?         @db.Text

  // Visibility
  isPublic           Boolean          @default(false)
  createdById        String
  createdBy          User             @relation("CampaignTemplateCreator", fields: [createdById], references: [id])

  // Usage tracking
  usageCount         Int              @default(0)

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([createdById])
  @@index([isPublic])
  @@index([category])
}

// ============================================================================
// BANKING & FINANCIAL
// ============================================================================

enum PayoutAccountType {
  BANK_ACCOUNT
  DEBIT_CARD
}

model BankingAccount {
  id                      String            @id @default(cuid())
  campaignId              String            @unique
  campaign                Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  // Balances (in cents)
  totalRaised             BigInt            @default(0)
  platformFeesCollected   BigInt            @default(0)
  availableBalance        BigInt            @default(0)
  disbursedTotal          BigInt            @default(0)
  pendingDisbursement     BigInt            @default(0)

  // External account info (encrypted in production)
  payoutAccountType       PayoutAccountType?
  payoutAccountLast4      String?
  payoutAccountVerified   Boolean           @default(false)

  // Stripe Connect (when using real payments)
  stripeConnectAccountId  String?

  // Controls
  dailyDisbursementLimit  BigInt?
  requiresGuardianApproval Boolean          @default(true)
  approvalThreshold       BigInt           @default(50000) // $500 in cents

  // Metadata
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  // Relations
  transactions            Transaction[]
  disbursementRequests    DisbursementRequest[]

  @@index([campaignId])
}

enum TransactionType {
  DEPOSIT
  DISBURSEMENT
  FEE_COLLECTION
  REFUND
  ADJUSTMENT
  CHARGEBACK
}

model Transaction {
  id                String          @id @default(cuid())
  bankingAccountId  String
  bankingAccount    BankingAccount  @relation(fields: [bankingAccountId], references: [id], onDelete: Cascade)

  type              TransactionType
  amount            BigInt          // In cents (positive for deposits, negative for disbursements)
  balanceAfter      BigInt          // Running balance after this transaction

  // References
  donationId        String?
  donation          Donation?       @relation(fields: [donationId], references: [id])
  disbursementId    String?
  disbursement      DisbursementRequest? @relation(fields: [disbursementId], references: [id])

  description       String
  metadata          Json?

  createdAt         DateTime        @default(now())
  createdBy         String?
  createdByUser     User?           @relation(fields: [createdBy], references: [id])

  @@index([bankingAccountId])
  @@index([donationId])
  @@index([createdAt])
}

// ============================================================================
// DONATIONS
// ============================================================================

enum DonationStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  DISPUTED
}

enum PaymentMethod {
  CARD
  ACH
  WALLET
}

enum PaymentProvider {
  STRIPE
  SIMULATED
}

model Donation {
  id                String          @id @default(cuid())
  campaignId        String
  campaign          Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  donorId           String?
  donor             User?           @relation(fields: [donorId], references: [id])
  teamMemberId      String?
  teamMember        TeamMember?     @relation("TeamMemberDonations", fields: [teamMemberId], references: [id])

  // Amounts (in cents)
  grossAmount       BigInt          // What donor paid
  platformFee       BigInt          // 10% of gross
  netAmount         BigInt          // Goes to campaign
  processingFee     BigInt          // Stripe/payment processor fee

  // Donor info (encrypted in production)
  donorEmail        String
  donorName         String?
  donorMessage      String?         @db.Text
  isAnonymous       Boolean         @default(false)

  // Payment details
  paymentProvider   PaymentProvider @default(SIMULATED)
  // Unique so a redelivered Stripe webhook can never insert a second donation
  // for the same payment intent and credit the campaign twice; lib/banking.ts
  // processDonation relies on the resulting P2002 as its last line of defence.
  // Safe on a nullable column: Postgres treats NULLs as distinct, so the many
  // simulated/legacy donations with no payment intent are all still legal.
  paymentIntentId   String?         @unique
  paymentMethod     PaymentMethod   @default(CARD)
  paymentMethodLast4 String?

  // Referral tracking
  referredByUserId  String?
  referralCode      String?
  utmSource         String?

  status            DonationStatus  @default(PENDING)

  // Chargeback / dispute. disputeId is Stripe's dp_*; unique so a redelivered
  // charge.dispute.created cannot attach the same dispute to two donations.
  disputeId         String?         @unique
  disputedAt        DateTime?
  disputeFee        BigInt          @default(0)

  // Cumulative gross cents already reversed by refunds. Partial refunds stay
  // COMPLETED until this reaches grossAmount, then status becomes REFUNDED.
  refundedAmount    BigInt          @default(0)

  // Tax receipt
  taxReceiptUrl     String?
  taxReceiptSentAt  DateTime?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Relations
  transactions      Transaction[]
  cheerMessage      CheerWallMessage?

  @@index([campaignId])
  @@index([donorId])
  @@index([teamMemberId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// DISBURSEMENTS
// ============================================================================

enum DisbursementStatus {
  PENDING
  APPROVED
  PROCESSING
  REJECTED
  COMPLETED
  CANCELLED
}

model DisbursementRequest {
  id                  String              @id @default(cuid())
  bankingAccountId    String
  bankingAccount      BankingAccount      @relation(fields: [bankingAccountId], references: [id], onDelete: Cascade)
  campaignId          String

  // Request details
  requestedAmount     BigInt              // In cents
  purpose             String
  description         String?             @db.Text
  receiptsUrls        String[]

  // Requester
  requestedBy         String
  requestedByUser     User                @relation("RequestedBy", fields: [requestedBy], references: [id])
  requestedAt         DateTime            @default(now())

  // Status
  status              DisbursementStatus  @default(PENDING)

  // Approval
  approvedBy          String?
  approvedByUser      User?               @relation("ApprovedBy", fields: [approvedBy], references: [id])
  approvedAt          DateTime?
  rejectionReason     String?             @db.Text

  // Completion
  disbursementDate    DateTime?
  payoutTransactionId String?

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  // Relations
  transactions        Transaction[]

  @@index([bankingAccountId])
  @@index([status])
  @@index([requestedBy])
}

// ============================================================================
// CAMPAIGN CONTENT
// ============================================================================

enum UpdateStatus {
  DRAFT
  PUBLISHED
}

model CampaignUpdate {
  id              String        @id @default(cuid())
  campaignId      String
  campaign        Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  authorId        String
  author          User          @relation(fields: [authorId], references: [id])

  title           String
  content         String        @db.Text
  imageUrls       String[]

  // Notifications
  notifyDonors    Boolean       @default(true)
  sentToEmails    Int           @default(0)
  sentToSms       Int           @default(0)

  publishedAt     DateTime?
  status          UpdateStatus  @default(DRAFT)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([campaignId])
  @@index([status])
}

model CheerWallMessage {
  id            String    @id @default(cuid())
  campaignId    String
  campaign      Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  donationId    String?   @unique
  donation      Donation? @relation(fields: [donationId], references: [id])

  authorName    String
  message       String    @db.Text
  isAnonymous   Boolean   @default(false)

  // Moderation
  isApproved    Boolean   @default(true)
  isFlagged     Boolean   @default(false)

  createdAt     DateTime  @default(now())

  @@index([campaignId])
  @@index([createdAt])
}

// ============================================================================
// REFERRALS & TEAM MEMBERS
// ============================================================================

enum RewardType {
  BADGE
  POINTS
  PRIZE
}

model Referral {
  id              String      @id @default(cuid())
  campaignId      String
  campaign        Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  referrerId      String
  referrer        User        @relation(fields: [referrerId], references: [id])
  referralCode    String      @unique

  // Tracking
  clickCount      Int         @default(0)
  donationCount   Int         @default(0)
  totalRaised     BigInt      @default(0) // In cents

  // Rewards
  rewardType      RewardType?
  rewardValue     BigInt?
  rewardUnlockedAt DateTime?

  createdAt       DateTime    @default(now())

  @@index([campaignId])
  @@index([referrerId])
  @@index([referralCode])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EMAIL_FAILED
  EXPIRED
}

model TeamMember {
  id              String    @id @default(cuid())
  campaignId      String
  campaign        Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?     @relation(fields: [userId], references: [id])

  name            String
  email           String?   // Player's email
  // DEPRECATED. `phoneNumber` is the canonical player phone — every write path
  // (staff add, roster import, player onboarding) targets it. This column is
  // retained only because two read sites still reference it
  // (app/api/programs/[programId]/alumni/route.ts, lib/alumni.ts) and both
  // already fall back to phoneNumber. Existing values were backfilled into
  // phoneNumber by 20260722_team_member_partial_unique_and_phone.sql; nothing
  // writes here any more. Drop the column once those two readers are updated.
  phone           String?
  phoneNumber     String?   // Canonical player phone
  personalGoal    BigInt?   // In cents
  amountRaised    BigInt    @default(0) // In cents

  // Player Profile
  profilePhotoUrl String?
  profileVideoUrl String?
  personalStory   String?   @db.Text
  position        String?   // For sports teams
  grade           String?   // For schools (free text, e.g. "11th")
  graduationYear  Int?      // Drives alumni identification across seasons
  jerseyNumber    String?
  contactInvites  ContactInvite[]
  favoriteQuote   String?

  // Parent/Guardian 1 Information
  parentFirstName String?
  parentLastName  String?
  parentEmail     String?
  parentPhone     String?

  // Parent/Guardian 2 Information (optional second parent)
  secondParentFirstName String?
  secondParentLastName  String?
  secondParentEmail     String?
  secondParentPhone     String?

  // Invitation & Onboarding
  invitationToken       String?           @unique
  invitationStatus      InvitationStatus  @default(PENDING)
  invitationSentAt      DateTime?
  onboardingCompletedAt DateTime?
  fundLinkCode          String?           @unique
  joinedAt              DateTime?

  // Soft delete
  deletedAt       DateTime?

  // Visibility
  isProfilePublic Boolean   @default(false)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  contacts        Contact[]
  donations       Donation[] @relation("TeamMemberDonations")

  // NOTE: uniqueness of (campaignId, email) is enforced by a PARTIAL unique
  // index that Prisma's schema language cannot express, so it is created by
  // raw SQL in prisma/migrations/20260722_team_member_partial_unique_and_phone.sql:
  //
  //   CREATE UNIQUE INDEX "TeamMember_campaignId_email_live_key"
  //     ON "TeamMember"("campaignId", email) WHERE "deletedAt" IS NULL;
  //
  // It must stay partial. Soft delete is the only delete this table has, and an
  // unconditional unique index let a removed player's email permanently occupy
  // the slot: re-adding them failed at the database and no route could recover
  // it, because every TeamMember query filters `deletedAt: null`. Restoring the
  // soft-deleted row (rather than inserting a second one) is also what keeps the
  // player's historical `amountRaised` attached to them.
  //
  // Do NOT reintroduce `@@unique([campaignId, email])` — `prisma db push` would
  // then replace the partial index with an unconditional one and reinstate the bug.
  @@index([campaignId])
  @@index([invitationToken])
  @@index([fundLinkCode])
}

// ============================================================================
// CONTACTS & OUTREACH
// ============================================================================

enum ContactSource {
  MANUAL_IMPORT
  CSV_UPLOAD
  ROSTER_INVITE
  DONATION
}

model Contact {
  id              String        @id @default(cuid())
  teamMemberId    String
  teamMember      TeamMember    @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  // Contact info
  firstName       String?
  lastName        String?
  email           String?
  phone           String?

  // Metadata
  source          ContactSource @default(MANUAL_IMPORT)
  notes           String?       @db.Text

  // Consent capture — who asserted permission to contact this person, when, and
  // via which path. Queryable on purpose: a free-text note cannot answer
  // "show me every contact we mailed without a recorded attestation".
  consentAttestedAt   DateTime?
  consentSource       String?    // e.g. "contact-invite:PLAYER", "contact-invite:GUARDIAN"
  consentAttestedById String?    // ContactInvite.id or User.id when known
  tags            String[]

  // Tracking
  emailsSent      Int           @default(0)
  smsSent         Int           @default(0)
  lastContactedAt DateTime?
  donated         Boolean       @default(false)
  donationAmount  BigInt?       // In cents

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  outreachLogs    OutreachLog[]

  @@index([teamMemberId])
  @@index([email])
  @@index([phone])
}

enum OutreachType {
  EMAIL
  SMS
  BOTH
}

enum OutreachStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELLED
}

model OutreachCampaign {
  id              String          @id @default(cuid())
  campaignId      String
  campaign        Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdBy       String
  createdByUser   User            @relation(fields: [createdBy], references: [id])

  // Campaign details
  name            String
  type            OutreachType
  status          OutreachStatus  @default(DRAFT)

  // Content
  emailSubject    String?
  emailBody       String?         @db.Text
  smsBody         String?         @db.Text

  // Scheduling
  scheduledFor    DateTime?
  sentAt          DateTime?

  // Stats
  totalRecipients Int             @default(0)
  emailsSent      Int             @default(0)
  smsSent         Int             @default(0)
  emailsOpened    Int             @default(0)
  linksClicked    Int             @default(0)
  donationsReceived Int           @default(0)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  logs            OutreachLog[]

  @@index([campaignId])
  @@index([status])
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  OPENED
  CLICKED
}

model OutreachLog {
  id                  String            @id @default(cuid())
  outreachCampaignId  String
  outreachCampaign    OutreachCampaign  @relation(fields: [outreachCampaignId], references: [id], onDelete: Cascade)
  contactId           String?
  contact             Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)

  // Message details
  type                OutreachType
  recipientEmail      String?
  recipientPhone      String?
  status              MessageStatus     @default(PENDING)

  // Tracking
  sentAt              DateTime?
  deliveredAt         DateTime?
  openedAt            DateTime?
  clickedAt           DateTime?
  failureReason       String?

  // External IDs
  emailProvider       String?           // 'resend', 'sendgrid', etc.
  smsProvider         String?           // 'twilio'
  providerMessageId   String?

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([outreachCampaignId])
  @@index([contactId])
  @@index([status])
}


// ============================================================================
// ROSTER IMPORT / CONTACT COLLECTION / ALUMNI
// ============================================================================

enum RosterImportSource {
  HUDL_CSV
  GENERIC_CSV
  MANUAL_PASTE
}

model RosterImport {
  id             String             @id @default(cuid())
  programId      String?
  program        Program?           @relation(fields: [programId], references: [id])
  campaignId     String
  campaign       Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  source         RosterImportSource @default(GENERIC_CSV)
  seasonYear     Int?
  fileName       String?
  columnMapping  Json?              // header -> field, so a re-import is reproducible

  rowsTotal      Int                @default(0)
  rowsImported   Int                @default(0)
  rowsSkipped    Int                @default(0)
  rowsFailed     Int                @default(0)

  importedById   String
  importedBy     User               @relation("RosterImporter", fields: [importedById], references: [id])
  createdAt      DateTime           @default(now())

  @@index([campaignId])
  @@index([programId])
}

enum ContactInviteRole {
  PLAYER
  GUARDIAN
}

// Tokenised link a player opens to add supporters, or forwards to a parent so the
// parent can add them instead. No account required for the guardian path.
model ContactInvite {
  id             String            @id @default(cuid())
  teamMemberId   String
  teamMember     TeamMember        @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  token          String            @unique
  role           ContactInviteRole @default(PLAYER)
  expiresAt      DateTime?
  revokedAt      DateTime?
  lastUsedAt     DateTime?
  useCount       Int               @default(0)

  createdAt      DateTime          @default(now())

  @@index([teamMemberId])
  @@index([token])
}

enum OptOutChannel {
  EMAIL
  SMS
  ALL
}

enum OptOutSource {
  UNSUBSCRIBE_LINK
  SMS_STOP
  MANUAL
  BOUNCE
  COMPLAINT
}

// Suppression list. Every outreach path must check this before sending.
// Scoped to a program when known, but a null programId means suppress everywhere.
model ContactOptOut {
  id          String        @id @default(cuid())
  programId   String?
  program     Program?      @relation(fields: [programId], references: [id])

  email       String?
  phone       String?
  channel     OptOutChannel @default(ALL)
  source      OptOutSource  @default(UNSUBSCRIBE_LINK)
  note        String?

  createdAt   DateTime      @default(now())

  @@index([email])
  @@index([phone])
  @@index([programId])
}
